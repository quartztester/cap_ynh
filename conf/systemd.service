[Unit]
Description=cap proof-of-work captcha server (__APP__)
After=network.target __APP__-redis.service
Requires=__APP__-redis.service

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/env
ExecStart=__INSTALL_DIR__/bin/bun run ./src/index.js
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
SyslogIdentifier=__APP__

; Hardening. NB: no ProtectHome — bun may touch $HOME for its cache and the
; data_dir lives under /home/yunohost.app.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectHome=no
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
