# Rendered from conf/env by the package — chmod 600, app user only: contains the admin key and the private redis auth password.

SERVER_HOSTNAME=127.0.0.1
SERVER_PORT=__PORT__

ADMIN_KEY=__ADMIN_KEY__

REDIS_URL=redis://:__REDIS_PASSWORD__@127.0.0.1:__REDIS_PORT__

# OFF by default so embedded widgets never get URLs pointing at the path-less subdomain; flip to true/pinned versions (see README.md) to self-mirror.
ENABLE_ASSETS_SERVER=__ASSETS_SERVER__
WIDGET_VERSION=__WIDGET_VERSION__
WASM_VERSION=__WASM_VERSION__
CACHE_HOST=https://cdn.jsdelivr.net

SHOW_ERRORS=false
DEMO_MODE=false
