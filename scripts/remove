#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STOP SERVICES
#=================================================

ynh_script_progression "Stopping cap services..."

ynh_systemctl --service="$app" --action=stop
ynh_systemctl --service="${app}-redis" --action=stop

#=================================================
# REMOVE FILES
#=================================================

ynh_script_progression "Removing $app files..."

ynh_safe_rm "$install_dir"
ynh_safe_rm "$data_dir"

#=================================================
# REMOVE SYSTEM CONFIGURATIONS
#=================================================

ynh_script_progression "Removing system configurations..."

yunohost service remove "$app" || true
yunohost service remove "${app}-redis" || true

ynh_config_remove_systemd "$app"
ynh_config_remove_systemd "${app}-redis"
ynh_config_remove_nginx

# Leave redis-server apt packages in place: the shared system redis from
# Debian may be (re)used by other apps and YunoHost itself.

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "cap has been removed."
